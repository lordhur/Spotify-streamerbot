# ============================================================
#  Spotify-streamerbot — configuration (copie ce fichier en .env)
# ============================================================

# --- App Spotify (voir docs/spotify-dashboard-setup.md) ---
SPOTIFY_CLIENT_ID=cole_ton_client_id_ici
SPOTIFY_CLIENT_SECRET=cole_ton_client_secret_ici
# Doit être EXACTEMENT identique à la "Redirect URI" déclarée dans le dashboard Spotify
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# --- Playlist cible ---
# ID de la playlist, ou directement son URL Spotify :
#   ex: 37i9dQZF1DXcBWIGoYBM5M
#   ex: https://open.spotify.com/playlist/37i9dQZF1DXcBWIGoYBM5M?si=xxxx
SPOTIFY_PLAYLIST_ID=

# --- Bot ---
# Port du serveur local (Streamer.bot appellera http://localhost:PORT)
PORT=8888
# 127.0.0.1 = le bot n'est joignable que depuis ton PC (recommandé, ne change que pour déboguer)
HOST=127.0.0.1

# Commandes chat reconnues (séparées par des virgules)
COMMANDS=!sr,!song

# Cooldown par viewer, en secondes (300 = 5 min). 0 = désactivé.
COOLDOWN_SECONDS=300
# pseudos Twitch exemptés du cooldown (toi + tes mods), séparés par des virgules, en minuscules
COOLDOWN_EXEMPT=ton_pseudo_twitch,mod1,mod2

# true = refuse d'ajouter un titre déjà présent dans la playlist
BLOCK_DUPLICATES=true

# Marché Spotify pour les recherches (disponibilité des titres)
SPOTIFY_MARKET=FR

# Longueur max d'une recherche (caractères)
MAX_QUERY_LENGTH=200

# --- Scopes OAuth (ne change que si tu sais ce que tu fais) ---
# playlist-modify-public / playlist-modify-private : ajouter des titres
# user-read-currently-playing : commande !now (morceau en cours)
SPOTIFY_SCOPES=playlist-modify-public playlist-modify-private user-read-currently-playing

# --- Avancé (ne pas toucher sauf tests) ---
# SPOTIFY_API_BASE=https://api.spotify.com/v1
# SPOTIFY_ACCOUNTS_BASE=https://accounts.spotify.com
# TOKEN_FILE=.token.json
# STATE_FILE=data/state.json
